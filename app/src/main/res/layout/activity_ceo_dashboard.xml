<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@color/background">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/gradient_header" android:orientation="vertical"
            android:padding="20dp" android:paddingBottom="28dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_dashboard"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="12dp"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Welcome," android:textColor="#BBDEFB" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvCEOName" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="CEO"
                        android:textColor="#FFFFFF" android:textSize="20sp" android:fontFamily="sans-serif-bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Chief Executive Officer" android:textColor="#BBDEFB" android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivNotif"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:src="@drawable/ic_notification"
                    android:background="@drawable/bg_circle"
                    app:tint="#FFFFFF" android:padding="8dp"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <!-- Stats Row 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <androidx.cardview.widget.CardView android:id="@+id/cardEmployees"
                        android:layout_width="0dp" android:layout_height="110dp"
                        android:layout_weight="1" android:layout_marginEnd="6dp" app:cardCornerRadius="12dp" app:cardElevation="4dp"
                        android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@color/card_blue" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/tvTotalEmployees" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="0" android:textColor="@color/white"
                                android:textSize="28sp" android:fontFamily="sans-serif-bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Employees" android:textColor="#BBDEFB" android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView android:id="@+id/cardPresentToday"
                        android:layout_width="0dp" android:layout_height="110dp"
                        android:layout_weight="1" android:layout_marginStart="6dp" app:cardCornerRadius="12dp" app:cardElevation="4dp"
                        android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@color/card_teal" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/tvPresentToday" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="0" android:textColor="@color/white"
                                android:textSize="28sp" android:fontFamily="sans-serif-bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Present Today" android:textColor="#B2EBF2" android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Stats Row 2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="16dp">
                    <androidx.cardview.widget.CardView android:id="@+id/cardManagers"
                        android:layout_width="0dp" android:layout_height="110dp"
                        android:layout_weight="1" android:layout_marginEnd="6dp" app:cardCornerRadius="12dp" app:cardElevation="4dp"
                        android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@color/card_purple" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/tvTotalManagers" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="0" android:textColor="@color/white"
                                android:textSize="28sp" android:fontFamily="sans-serif-bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Managers" android:textColor="#E1BEE7" android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView android:id="@+id/cardAvgKPI"
                        android:layout_width="0dp" android:layout_height="110dp"
                        android:layout_weight="1" android:layout_marginStart="6dp" app:cardCornerRadius="12dp" app:cardElevation="4dp"
                        android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@color/card_green" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/tvAvgKPI" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="—" android:textColor="@color/white"
                                android:textSize="28sp" android:fontFamily="sans-serif-bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Avg KPI" android:textColor="#C8E6C9" android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Quick Actions -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Strategic View" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:fontFamily="sans-serif-bold" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/qaPerformance" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="8dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                        <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp"
                            app:cardCornerRadius="14dp" app:cardBackgroundColor="#F3E5F5" app:cardElevation="2dp">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                                android:src="@drawable/ic_performance" app:tint="@color/card_purple"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="KPI Reports" android:textSize="11sp" android:layout_marginTop="5dp" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/qaAttendance" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="8dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                        <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp"
                            app:cardCornerRadius="14dp" app:cardBackgroundColor="#E0F7FA" app:cardElevation="2dp">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                                android:src="@drawable/ic_attendance" app:tint="@color/card_teal"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Attendance" android:textSize="11sp" android:layout_marginTop="5dp" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/qaFeedback" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="8dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                        <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp"
                            app:cardCornerRadius="14dp" app:cardBackgroundColor="#FCE4EC" app:cardElevation="2dp">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                                android:src="@drawable/ic_feedback" app:tint="@color/card_pink"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="AI Feedback" android:textSize="11sp" android:layout_marginTop="5dp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="4dp" android:gravity="center">
                    <LinearLayout android:id="@+id/qaSales" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="8dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                        <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp"
                            app:cardCornerRadius="14dp" app:cardBackgroundColor="#E8F5E9" app:cardElevation="2dp">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                                android:src="@drawable/ic_sales" app:tint="@color/card_green"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Sales Analytics" android:textSize="11sp" android:layout_marginTop="5dp" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/qaReports" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="8dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                        <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp"
                            app:cardCornerRadius="14dp" app:cardBackgroundColor="#E3F2FD" app:cardElevation="2dp">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                                android:src="@drawable/ic_dashboard" app:tint="@color/primary"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="All Reports" android:textSize="11sp" android:layout_marginTop="5dp" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/qaNotifications" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="8dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                        <androidx.cardview.widget.CardView android:layout_width="52dp" android:layout_height="52dp"
                            app:cardCornerRadius="14dp" app:cardBackgroundColor="#FFF8E1" app:cardElevation="2dp">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                                android:src="@drawable/ic_notification" app:tint="#F57F17"/>
                        </androidx.cardview.widget.CardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Notifications" android:textSize="11sp" android:layout_marginTop="5dp" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Side Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        app:menu="@menu/drawer_menu"
        android:fitsSystemWindows="true"/>

</androidx.drawerlayout.widget.DrawerLayout>