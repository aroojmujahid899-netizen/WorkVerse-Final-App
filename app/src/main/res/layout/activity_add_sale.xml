<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Sales Record"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="16dp"/>

    <!-- Employee Dropdown (replaces free text field) -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <AutoCompleteTextView
            android:id="@+id/actEmployee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Employee"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Designation Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <AutoCompleteTextView
            android:id="@+id/actDesignation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Designation"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Campaign Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <AutoCompleteTextView
            android:id="@+id/actCampaign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Campaign"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Bi-Monthly Target (Fixed 30 Default) -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Target (Bi-Monthly)"
            android:text="30"
            android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Achieved Count -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAchieved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Achieved Count"
            android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>