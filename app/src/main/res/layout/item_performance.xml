<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardCornerRadius="10dp" app:cardElevation="3dp"
    android:layout_marginBottom="10dp" app:cardBackgroundColor="@color/white">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">

        <!-- Row 1: Avatar + Name + Donut KPI -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <androidx.cardview.widget.CardView
                android:layout_width="40dp" android:layout_height="40dp"
                app:cardCornerRadius="20dp" app:cardBackgroundColor="@color/primary"
                app:cardElevation="0dp" android:layout_marginEnd="10dp">
                <TextView android:id="@+id/tvInitials"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:text="?"
                    android:textColor="@color/white" android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/tvEmployeeName" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Employee Name"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:fontFamily="sans-serif-bold" android:layout_marginEnd="6dp"/>
                    <TextView android:id="@+id/tvCampaign" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Campaign"
                        android:textColor="@color/primary" android:textSize="9sp"
                        android:paddingStart="6dp" android:paddingEnd="6dp"
                        android:paddingTop="2dp" android:paddingBottom="2dp"
                        android:background="@drawable/bg_role_employee" android:visibility="gone"/>
                </LinearLayout>

                <TextView android:id="@+id/tvMonth" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Month Year"
                    android:textColor="@color/text_secondary" android:textSize="12sp"/>
            </LinearLayout>

            <FrameLayout android:layout_width="60dp" android:layout_height="60dp">
                <com.workverse.app.views.DonutChartView
                    android:id="@+id/donutKpi"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/tvKpi" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0%"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="KPI" android:textSize="8sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp"
            android:layout_marginStart="50dp">
            <TextView android:id="@+id/tvTasks" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Tasks: 0/0" android:textSize="12sp"
                android:textColor="@color/text_secondary"/>
            <TextView android:id="@+id/tvAttendance" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Attendance: 0%" android:textSize="12sp"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#EEEEEE" android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                android:src="@drawable/ic_performance" app:tint="#7B1FA2"
                android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/tvSentiment" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="AI: Neutral"
                android:textColor="@color/white" android:textSize="11sp"
                android:fontFamily="sans-serif-bold" android:paddingStart="8dp"
                android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp"
                android:background="@drawable/bg_badge_neutral" android:visibility="gone"/>
        </LinearLayout>

        <TextView android:id="@+id/tvInsight" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text=""
            android:textColor="#7B1FA2" android:textSize="11sp"
            android:fontFamily="sans-serif-light" android:visibility="gone"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>