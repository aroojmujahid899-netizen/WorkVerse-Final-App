<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardCornerRadius="10dp" app:cardElevation="2dp" android:layout_margin="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvName" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Name"
                android:textSize="15sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/tvDate" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Date"
                android:textColor="@color/text_secondary" android:textSize="13sp"/>
            <TextView android:id="@+id/tvCheckIn" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="In: —"
                android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Present"
            android:textColor="@color/status_approved" android:textSize="12sp"
            android:padding="6dp" android:background="@drawable/bg_status_approved"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>